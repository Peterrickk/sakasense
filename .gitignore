# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/test-results/
/playwright-report/

# Dashboard (sakasense_main): build output, dependencies, Python env and local data
/sakasense_main/web/.next/
/sakasense_main/web/node_modules/
/sakasense_main/web/dev.log
/sakasense_main/.venv/
__pycache__/
*.pyc
/sakasense_main/db.sqlite3
