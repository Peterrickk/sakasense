# SakaSense main website — environment variables.
# Copy to `.env` (or `.env.local`) and fill in. NEVER commit the real file.
# In production (Vercel), set these in the project's Environment Variables instead.

# --- Site URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the SakaSense web dashboard (sakasense_main/web) runs. Defaults to NEXT_PUBLIC_SITE_URL + /app,
# which is where vercel.json mounts it. Only set this for a standalone `npm run dev:dashboard`.
# NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001/app

# --- Database (Neon or Supabase Postgres) ---
# Without it the public pages still work (seed data); checkout, accounts, admin and forms need it.
DATABASE_URL=

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional (international cards); also set siteConfig.features.stripe = true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="SakaSense <orders@your-domain.com>"

# --- Admin user created by `npm run db:seed` ---
ADMIN_EMAIL=
# Optional; a random one is generated and printed once if empty
ADMIN_PASSWORD=
