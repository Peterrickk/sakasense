{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": ".",
      "framework": "nextjs"
    },
    "dashboard": {
      "root": "sakasense_main/web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "SAKASENSE_API_URL" }
      ]
    },
    "api": {
      "root": "sakasense_main",
      "framework": "django"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": { "service": "dashboard" } },
    { "source": "/app/(.*)", "destination": { "service": "dashboard" } },
    { "source": "/(.*)", "destination": { "service": "website" } }
  ]
}
