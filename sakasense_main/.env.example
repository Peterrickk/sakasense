# SakaSense dashboard API (Django) — environment variables.
# Set these on the server (e.g. Render). Django reads them from the process environment.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
# Not needed on Vercel (internal-only service; defaults to any host there).
ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres in production; if empty, the local db.sqlite3 is used
DATABASE_URL=
# Comma-separated sites allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
