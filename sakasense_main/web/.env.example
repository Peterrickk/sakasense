# URL of the main SakaSense website ("back to website" / "get the device" links).
# Leave unset on Vercel: both apps share one domain, so links are same-origin.
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000
# The Django API URL comes from the `api` service binding (SAKASENSE_API_URL) that Vercel injects,
# including under `vercel dev`. Don't set it yourself; plain `npm run dev` falls back to http://127.0.0.1:8000.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
